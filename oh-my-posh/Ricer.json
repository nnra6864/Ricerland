{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#3078BF",
          "foreground": "#ACCAE6",
          "properties": {
          "time_format": "15:04:05"
        },
          "style": "diamond",
          "template": "🕰 {{ .CurrentDate | date .Format }} ",
          "leading_diamond": "",
          "trailing_diamond": "",
          "type": "time"
        },
        {
          "background": "#337FCC",
          "foreground": "#ACCAE6",
          "style": "diamond",
          "template": " {{ .Icon }} ",
          "leading_diamond": "",
          "trailing_diamond": "<#ACCAE6> ",
          "type": "os"
        },
        {
          "type": "session",
          "style": "diamond",
          "background": "#337FCC",
          "foreground": "{{ if .Root }}#BF3030{{ else }}#ACCAE6{{ end }}",
          "trailing_diamond": "",
          "template": "{{ if .SSHSession }} {{ end }}{{ .UserName }} ☦ {{ .HostName }} "
        },
        {
          "background": "#3687D8",
          "foreground": "#ACCAE6",
          "properties": {
            "folder_icon": " ",
            "folder_separator_icon": "  ",
            "home_icon": "",
            "style": "unique",
            "max_depth": 1
          },
          "style": "diamond",
          "template": " {{ .Path }} ",
          "leading_diamond": "",
          "trailing_diamond": "",
          "type": "path"
        },
        {
          "background": "#3A8FE5",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#608FBF{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#8330BF{{ end }}",
            "{{ if gt .Ahead 0 }}#60BF30{{ end }}",
            "{{ if gt .Behind 0 }}#BFA730{{ end }}"
          ],
          "foreground": "#ACCAE6",
          "powerline_symbol": "",
          "properties": {
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .UpstreamIcon }}  {{ .HEAD }} {{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{if .Root}} \u26a1 {{end}}{{.Folder | replace \"~\" \"\"}} @ {{.HostName}}",
  "final_space": true,
  "version": 3
}

