{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#ricer.col.white",
          "foreground": "#ricer.col.black",
          "properties": {
          "time_format": "15:04:05"
        },
          "style": "diamond",
          "template": "🕰 {{ .CurrentDate | date .Format }} ",
          "leading_diamond": "<#ricer.col.white,transparent>",
          "trailing_diamond": "<#ricer.col.white,#ricer.col.br_cyan>",
          "type": "time"
        },
        {
          "background": "#ricer.col.br_cyan",
          "foreground": "#ricer.col.black",
          "style": "diamond",
          "template": " {{ .Icon }} ",
          "trailing_diamond": "<#ricer.col.cyan> ",
          "type": "os"
        },
        {
          "type": "session",
          "style": "diamond",
          "background": "#ricer.col.br_cyan",
          "foreground": "{{ if .Root }}#ricer.col.red{{ else }}#ricer.col.black{{ end }}",
          "trailing_diamond": "",
          "template": "{{ if .SSHSession }} {{ end }}{{ .UserName }} "
        },
        {
          "background": "#ricer.col.br_blue",
          "foreground": "#ricer.col.white",
          "properties": {
            "folder_icon": " ",
            "folder_separator_icon": "  ",
            "home_icon": "",
            "style": "unique",
            "max_depth": 1
          },
          "style": "diamond",
          "template": " {{ .Path }} ",
          "trailing_diamond": "",
          "type": "path"
        },
        {
          "background": "#ricer.col.blue",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ricer.col.cyan{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ricer.col.magenta{{ end }}",
            "{{ if gt .Ahead 0 }}#ricer.col.green{{ end }}",
            "{{ if gt .Behind 0 }}#ricer.col.yellow{{ end }}"
          ],
          "foreground": "#ricer.col.white",
          "powerline_symbol": "",
          "properties": {
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{if .Root}} \u26a1 {{end}}{{.Folder | replace \"~\" \"\"}} @ {{.HostName}}",
  "final_space": true,
  "version": 3
}

