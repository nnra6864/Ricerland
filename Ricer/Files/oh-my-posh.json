{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#ricer.col.prompt_time_bg",
          "foreground": "#ricer.col.prompt_time_fg",
          "properties": {
          "time_format": "15:04:05"
        },
          "style": "diamond",
          "template": "🕰   {{ .CurrentDate | date .Format }} ",
          "leading_diamond": "",
          "trailing_diamond": "",
          "type": "time"
        },
        {
          "background": "#ricer.col.prompt_os_bg",
          "foreground": "#ricer.col.prompt_os_fg",
          "style": "diamond",
          "template": " {{ .Icon }}  ",
          "leading_diamond": "",
          "type": "os"
        },
        {
          "type": "session",
          "style": "diamond",
          "background": "#ricer.col.prompt_os_bg",
          "foreground": "{{ if .Root }}#ricer.col.red{{ else }}#ricer.col.prompt_os_fg{{ end }}",
          "trailing_diamond": "",
          "template": "{{ if .SSHSession }} {{ end }}{{ .UserName }} ☦ {{ .HostName }} "
        },
        {
          "background": "#ricer.col.prompt_dir_bg",
          "foreground": "#ricer.col.prompt_dir_fg",
          "properties": {
            "folder_icon": " ",
            "folder_separator_icon": "  ",
            "home_icon": "",
            "style": "unique",
            "max_depth": 1
          },
          "style": "diamond",
          "template": " {{ .Path }} ",
          "leading_diamond": "",
          "trailing_diamond": "",
          "type": "path"
        },
        {
          "background": "#ricer.col.prompt_git_bg",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ricer.col.prompt_git_changed{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ricer.col.prompt_git_diverged{{ end }}",
            "{{ if gt .Ahead 0 }}#ricer.col.prompt_git_ahead{{ end }}",
            "{{ if gt .Behind 0 }}#ricer.col.prompt_git_behind{{ end }}"
          ],
          "foreground": "#ricer.col.prompt_git_fg",
          "powerline_symbol": "",
          "properties": {
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .UpstreamIcon }}  {{ .HEAD }}{{ if .Staging.Changed }}  \uf046 {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }}  |{{ end }}{{ if .Working.Changed }}  \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }}  \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{if .Root}} \u26a1 {{end}}{{.Folder | replace \"~\" \"\"}} @ {{.HostName}}",
  "final_space": true,
  "version": 3
}

