{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#ricer.col.foreground",
          "foreground": "#ricer.col.background",
          "properties": {
          "time_format": "15:04:05"
        },
          "style": "diamond",
          "template": " {{ .CurrentDate | date .Format }} ",
          "leading_diamond": "<#ricer.col.foreground,transparent>\ue0b6</>",
          "trailing_diamond": "\ue0b0",
          "type": "time"
        },
        {
          "background": "#ricer.col.cyan",
          "foreground": "#ricer.col.background",
          "leading_diamond": "<transparent,#ricer.col.cyan>\ue0b0</>",
          "style": "diamond",
          "template": " {{ .Icon }} ",
          "trailing_diamond": "<#ricer.col.background>\ue0b1",
          "type": "os"
        },
        {
          "background": "#ricer.col.cyan",
          "foreground": "#ricer.col.background",
          "properties": {
            "folder_icon": "...",
            "folder_separator_icon": "<#ricer.col.background> \ue0b1 </>",
            "home_icon": "\ueb06",
            "style": "agnoster_short"
          },
          "style": "diamond",
          "template": " {{ .Path }} ",
          "trailing_diamond": "\ue0b0",
          "type": "path"
        },
        {
          "background": "#ricer.col.blue",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ricer.col.yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ricer.col.magenta{{ end }}",
            "{{ if gt .Ahead 0 }}#ricer.col.green{{ end }}",
            "{{ if gt .Behind 0 }}#ricer.col.cyan{{ end }}"
          ],
          "foreground": "#ricer.col.background",
          "powerline_symbol": "\ue0b0",
          "properties": {
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    }
  ],
  "console_title_template": "{{if .Root}} \u26a1 {{end}}{{.Folder | replace \"~\" \"\"}} @ {{.HostName}}",
  "final_space": true,
  "version": 3
}

