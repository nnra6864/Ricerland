[global]
follow = mouse
width = (0, 500)
height = (0, 100)
notification_limit = 1
origin = top-center
offset = (0, 10)
progress_bar_max_width = 500
progress_bar_corner_radius = 0
font = "Courier Prime Code 15"
corner_radius = 10
frame_width = 2
mouse_left_click = do_action, close_current
mouse_middle_click = close_current
mouse_right_click = context
transparency = 100
background = "#08080801"
foreground = "#B2B2B2FF"
highlight = "#CBCBCBFF"
frame_color = "#B2B2B2FF"
separator_color = frame
format = "<span color='#CBCBCBFF'>%s</span>\n%b"
icon_corner_radius = 10
timeout = 3
show_indicators = no
