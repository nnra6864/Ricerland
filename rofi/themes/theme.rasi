* {
	background-col: rgba(76, 88, 67, 1.0);
	background-selected-col: rgba(62, 70, 55, 1.0);
    background-color: transparent;
    transparency: "real";

	color: #D8DED3;
	text-col: #D8DED3;
	text-selected-col: #D8DED3;
	border-col: #282E22;
    highlight: underline bold #F1F7EB;
}

window {
    location: center;
    anchor: center;
	width: 800px;
	height: 40%;
    border: 0%;
    border-radius: 0px;

	fullscreen: false;
    children: [mainbox];
    orientation: horizontal;
    spacing: 0;
}

mainbox {
    spacing: 0;
    children: [ inputbar, message, listview ];
}

message {
    padding: 16px;
	background-color: @background-col;

    border-color: @border-col;
    border-radius: 0;
    border:  0 2px 2px 2px;
}

inputbar {
    padding: 16px;
    background-color: @background-col;

    border: 2px;
    border-radius: 0px 0px 0 0;
    border-color: @border-col;
}

entry, prompt, case-indicator {
    text-font: inherit;
    text-color: inherit;
}

prompt {
    margin: 0 1em 0 0;
}

listview {
    padding: 0;
    border-radius: 0 0 0px 0px;
    border-color: @border-col;
    border: 0 2px 2px 2px;
    background-color: @background-col;
    dynamic: false;
}

element {
    padding: 15px 25px 15px 6px;
    vertical-align: 0.5;
    border-radius: 0;
    background-color: transparent;
    color: @text-col;
    text-color: @text-col;
}

element-icon{
	size: 1em;
	padding: 0 25px 0 0;
}

element selected.normal {
	background-color: @background-selected-col;
	text-color: @text-selected-col;
}

element-text, element-icon {
    background-color: transparent;
    text-color: inherit;
}

button {
    padding: 6px;
    color: @text-col;
    horizontal-align: 0.5;

    border: 2px 0 2px 2px;
    border-radius: 0;
    border-color: @border-col;
}

button selected normal {
    border: 2px 0 2px 2px;
    border-color: @border-col;
}
