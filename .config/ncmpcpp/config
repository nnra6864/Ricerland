volume_change_step = 5
user_interface     = alternative
progressbar_look   = ⪼⫸⪼

visualizer_data_source = "/tmp/mpd.fifo"
visualizer_output_name = "my_fifo"
visualizer_in_stereo   = "yes"
visualizer_type        = "spectrum"
visualizer_look        = "❖❖"
visualizer_fps         = 144

# Required for startup window rule to work
song_window_title_format = ncmpcpp

# ┌───────────────────────────┐
# │           Colors          │
# ├─────────┬────────┬────────┤
# │ Name    │ Normal │ Bright │
# ├─────────┼────────┼────────┤
# │ Black   │ 0      │ 9      │
# │ Red     │ 0      │ 10     │
# │ Green   │ 0      │ 11     │
# │ Yellow  │ 0      │ 12     │
# │ Blue    │ 0      │ 13     │
# │ Magenta │ 0      │ 14     │
# │ Cyan    │ 0      │ 15     │
# │ White   │ 0      │ 16     │
# └─────────┴────────┴────────┘

# Colors
colors_enabled                 = yes
empty_tag_color                = 13
header_window_color            = white
volume_color                   = white
state_line_color               = white
state_flags_color              = 13
main_window_color              = 13
color1                         = white
color2                         = 13
progressbar_color              = 9:b
progressbar_elapsed_color      = 13:b
statusbar_color                = white
statusbar_time_color           = white
player_state_color             = 13
alternative_ui_separator_color = 9:b
window_border_color            = 15
active_window_border           = 13

# Prefix/Suffix
current_item_prefix                 = $r
current_item_suffix                 = $/r
current_item_inactive_column_prefix = 
current_item_inactive_column_suffix = 
now_playing_prefix                  = $b
now_playing_suffix                  = $/b
browser_playlist_prefix             = "$7playlist$5 "
selected_item_prefix                = $3
selected_item_suffix                = $9
modified_item_prefix                = $3> $9

# Format
song_columns_list_format              = (20)[13]{a} (6f)[15]{NE} (50)[white]{t|f:Title} (20)[13]{b} (7f)[15]{l}
alternative_header_first_line_format  = $5━┫$/a$9 ☦ {%t}|{%f} ☦ $5┣━$/a$9
alternative_header_second_line_format = {{$5%a$9}{ - $5%b$9}{ ($7%y$9)}}|{%D}
