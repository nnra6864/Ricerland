// US layout + Serbian latin letters on AltGr (Right Alt),
// placed where they sit on a Serbian latin keyboard.
// AltGr+key = lowercase, AltGr+Shift+key = uppercase.
//   [ -> š   ] -> đ   ; -> č   ' -> ć   \ -> ž
default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(basic)"
    include "level3(ralt_switch)"
    name[Group1] = "English (US, Serbian letters)";

    key <AD11> { [ bracketleft,  braceleft,  scaron,  Scaron  ] };
    key <AD12> { [ bracketright, braceright, dstroke, Dstroke ] };
    key <AC10> { [ semicolon,    colon,      ccaron,  Ccaron  ] };
    key <AC11> { [ apostrophe,   quotedbl,   cacute,  Cacute  ] };
    key <BKSL> { [ backslash,    bar,        zcaron,  Zcaron  ] };
};
