      <find>// Improved hash for smooth 3D value noise
float Hash(float3 p)
{
	p = frac(p * 0.3183099 + float3(0.71, 0.113, 0.419));
	p *= 17.0;
	return frac(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float Noise3D(float3 p)
{
	float3 i = floor(p);
	float3 f = frac(p);

	float3 u = f * f * (3.0 - 2.0 * f); // smoothstep interpolation

	float n000 = Hash(i + float3(0, 0, 0));
	float n100 = Hash(i + float3(1, 0, 0));
	float n010 = Hash(i + float3(0, 1, 0));
	float n110 = Hash(i + float3(1, 1, 0));
	float n001 = Hash(i + float3(0, 0, 1));
	float n101 = Hash(i + float3(1, 0, 1));
	float n011 = Hash(i + float3(0, 1, 1));
	float n111 = Hash(i + float3(1, 1, 1));

	float nx00 = lerp(n000, n100, u.x);
	float nx10 = lerp(n010, n110, u.x);
	float nx01 = lerp(n001, n101, u.x);
	float nx11 = lerp(n011, n111, u.x);

	float nxy0 = lerp(nx00, nx10, u.y);
	float nxy1 = lerp(nx01, nx11, u.y);

	return lerp(nxy0, nxy1, u.z);
}

// Final raymarching function with noise controls
void Raymarch_float(
	float3 RayOrigin,
	float3 RayDirection,
	float NumSteps,
	float StepSize,
	float DensityScale,
	float4 Sphere,
	float NoiseScale,
	float3 NoiseOffset,
	float2 NoiseRemap,
	float NoisePower,
	out float Result
)
{
	float density = 0;

	for (int i = 0; i &lt; (int)NumSteps; i++)
	{
		RayOrigin += RayDirection * StepSize;

		float sphereDist = distance(RayOrigin, Sphere.xyz);

		if (sphereDist &lt; Sphere.w)
		{
			float3 samplePos = RayOrigin * NoiseScale + NoiseOffset;
			float noise = Noise3D(samplePos);

			// Remap noise from [0,1] → [min,max]
			noise = lerp(NoiseRemap.x, NoiseRemap.y, noise);

			// Optional shaping of density
			noise = pow(noise, NoisePower);

			density += noise * 0.1;
		}
	}

	Result = density * DensityScale;
}
// Improved hash for smooth 3D value noise
float Hash(float3 p)
{
    p = frac(p * 0.3183099 + float3(0.71, 0.113, 0.419));
    p *= 17.0;
    return frac(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float Noise3D(float3 p)
{
    float3 i = floor(p);
    float3 f = frac(p);

    float3 u = f * f * (3.0 - 2.0 * f); // smoothstep interpolation

    float n000 = Hash(i + float3(0, 0, 0));
    float n100 = Hash(i + float3(1, 0, 0));
    float n010 = Hash(i + float3(0, 1, 0));
    float n110 = Hash(i + float3(1, 1, 0));
    float n001 = Hash(i + float3(0, 0, 1));
    float n101 = Hash(i + float3(1, 0, 1));
    float n011 = Hash(i + float3(0, 1, 1));
    float n111 = Hash(i + float3(1, 1, 1));

    float nx00 = lerp(n000, n100, u.x);
    float nx10 = lerp(n010, n110, u.x);
    float nx01 = lerp(n001, n101, u.x);
    float nx11 = lerp(n011, n111, u.x);

    float nxy0 = lerp(nx00, nx10, u.y);
    float nxy1 = lerp(nx01, nx11, u.y);

    return lerp(nxy0, nxy1, u.z);
}

// Domain warping function to help reduce visual cutoffs
float3 DomainWarp(float3 p, float3 offset)
{
    // Sample the noise at a different frequency and use it to warp the domain
    float3 warpPos = p * 0.5 + offset;
    float warp = Noise3D(warpPos) * 2.0 - 1.0;
    return p + warp * 0.15; // Subtle warping to avoid hard cutoffs
}

// Final raymarching function with opposite noise movement
void Raymarch_float(
    float3 RayOrigin,
    float3 RayDirection,
    float NumSteps,
    float StepSize,
    float DensityScale,
    float4 Sphere,
    float NoiseScale,
    float3 NoiseOffset,
    float2 NoiseRemap,
    float NoisePower,
    out float Result
)
{
    float density = 0;
    float stepWeight = 1.0 / max(1.0, NumSteps * 0.5); // Weight for each step, adjusted for performance
    
    for (int i = 0; i &lt; (int)NumSteps; i++)
    {
        RayOrigin += RayDirection * StepSize;

        float sphereDist = distance(RayOrigin, Sphere.xyz);

        if (sphereDist &lt; Sphere.w)
        {
            // Direction 1: Original noise
            float3 samplePos1 = DomainWarp(RayOrigin * NoiseScale, NoiseOffset);
            float noise1 = Noise3D(samplePos1);
            
            // Direction 2: Opposite direction noise - invert the offset
            float3 samplePos2 = DomainWarp(RayOrigin * NoiseScale, -NoiseOffset);
            float noise2 = Noise3D(samplePos2);
            
            // Blend the two noise patterns - using a seamless blend
            float blendFactor = sin(_Time.y * 0.2) * 0.5 + 0.5; // Subtle time-based blending
            float noise = lerp(noise1, noise2, blendFactor);
            
            // Add a second octave to reduce visible tiling artifacts
            float3 detailPos = DomainWarp(RayOrigin * NoiseScale * 2.5, NoiseOffset * 1.7);
            float detailNoise = Noise3D(detailPos) * 0.4;
            noise = saturate(noise + detailNoise);
            
            // Remap noise from [0,1] → [min,max]
            noise = lerp(NoiseRemap.x, NoiseRemap.y, noise);

            // Optional shaping of density with smoothing to reduce cutoffs
            noise = pow(noise, NoisePower);
            
            // Apply falloff near sphere edge to reduce cutoff artifacts
            float edgeFade = 1.0 - smoothstep(Sphere.w * 0.8, Sphere.w, sphereDist);
            noise *= edgeFade;
            
            density += noise * stepWeight;
        }
    }

    Result = density * DensityScale;
}</find>
