{
	"icon_theme": "Catppuccin Mocha",
	"theme": {
		"mode": "dark",
		"light": "Ricer",
		"dark": "Ricer"
	},

	"auto_install_extensions": {
		"lua": true,
		"csharp": true,
		"pylsp": true,
		"html": true,
		"scss": true,
		"markdown-oxide": true,
		"toml": true,
		"sql": true,
		"fish": true,
		"nu": true,
		"ini": true,
		"hyprlang": true,
		"git-firefly": true,
		"make": true,
		"catppuccin-icons": true,
		"symbols": true
	},

	"autoscroll_on_clicks": true,
	"base_keymap": "JetBrains",

	//Font
	"buffer_font_family": "Maple Mono NF CN",
	"buffer_font_size": 30,
	"buffer_font_weight": 400,
	"buffer_line_height": "comfortable",

	"ui_font_family": "Maple Mono NF CN",
	"ui_font_size": 30,
	"ui_font_weight": 400,

	"centered_layout": {
		"left_padding": 0.2,
		"right_padding": 0.2
	},

	"snippet_sort_order": "top",

	"features": {
		"edit_prediction_provider": "copilot"
	},

	"unnecessary_code_fade": 0.3,
	"vim_mode": true,
	"relative_line_numbers": true,
	"restore_on_startup": "last_session",
	"when_closing_with_no_tabs": "platform_default",
	"current_line_highlight": "all",

	//Completions
	"show_completions_on_input": true,
	"show_completion_documentation": true,
	"auto_signature_help": true,
	"show_signature_help_after_edits": true,

	//Guides
	"show_wrap_guides": true,
	"wrap_guides": [],
	"show_whitespaces": "all",

	"indent_guides": {
		"enabled": true,
		"line_width": 1,
		"active_line_width": 2,
		"coloring": "fixed",
		"background_coloring": "disabled"
	},

	"scrollbar": {
		"show": "never"
	},

	"middle_click_paste": false,
	"vertical_scroll_margin": 5,
	"scroll_sensitivity": 1.0,
	"search_wrap": true,
	"use_smartcase_search": true,

	"inlay_hints": {
		"enabled": true,
		"show_type_hints": true,
		"show_parameter_hints": true,
		"show_other_hints": true,
		"show_background": false,
		"edit_debounce_ms": 700,
		"scroll_debounce_ms": 50
	},

	"project_panel": {
		"button": true,
		"default_width": 240,
		"dock": "left",
		"file_icons": true,
		"folder_icons": true,
		"git_status": true,
		"indent_size": 20,
		"auto_reveal_entries": true,
		"auto_fold_dirs": true,
		"scrollbar": {
			"show": null
		}
	},

	"outline_panel": {
		"button": true,
		"default_width": 300,
		"dock": "right",
		"file_icons": true,
		"folder_icons": true,
		"git_status": true,
		"indent_size": 20,
		"auto_reveal_entries": true,
		"auto_fold_dirs": true
	},

	"collaboration_panel": {
		"button": true,
		"dock": "left",
		"default_width": 240
	},

	"chat_panel": {
		"button": "always",
		"dock": "right",
		"default_width": 240
	},

	"message_editor": {
		"auto_replace_emoji_shortcode": true
	},

	"notification_panel": {
		"button": true,
		"dock": "right",
		"default_width": 380
	},

	"language_models": {
		"openai": {
			"available_models": [
				{
					"name": "deepseek-coder",
					"max_tokens": 128000
				},
				{
					"name": "deepseek-chat",
					"max_tokens": 128000
				}
			],
			"api_url": "https://api.deepseek.com/beta"
		}
	},

	"agent": {
		"default_model": {
			"provider": "ollama",
			"model": "qwen2.5:32b"
		}
	},

	"slash_commands": {
		"docs": {
			"enabled": false
		},
		"project": {
			"enabled": false
		}
	},

	"show_call_status_icon": true,
	"enable_language_server": true,
	"linked_edits": true,
	"language_servers": ["..."],

	"tab_bar": {
		"show": true,
		"show_nav_history_buttons": true
	},

	"tabs": {
		"git_status": true,
		"close_position": "right",
		"file_icons": true
	},

	"file_finder": {
		"file_icons": true
	},

	"remove_trailing_whitespace_on_save": true,
	"extend_comment_on_newline": true,
	"ensure_final_newline_on_save": false,
	"format_on_save": "on",
	"formatter": "auto",
	"soft_wrap": "preferred_line_length",
	"preferred_line_length": 100,
	"hard_tabs": true,
	"tab_size": 4,

	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"auto_update": false,

	"diagnostics": {
		"button": true,
		"include_warnings": true,
		"inline": {
			"enabled": true,
			"update_debounce_ms": 150,
			"padding": 4,
			"min_column": 0,
			"max_severity": null
		},
		"cargo": null
	},

	"file_scan_exclusions": [
		"**/.git",
		"**/.svn",
		"**/.hg",
		"**/CVS",
		"**/.DS_Store",
		"**/Thumbs.db",
		"**/.classpath",
		"**/.settings"
	],

	"git": {
		"git_gutter": "tracked_files",
		"inline_blame": {
			"enabled": true
		}
	},

	"edit_predictions": {
		"disabled_globs": [".env"]
	},

	"journal": {
		"path": "~",
		"hour_format": "hour24"
	},

	"terminal": {
		"shell": "system",
		"dock": "bottom",
		"default_width": 640,
		"default_height": 320,
		"working_directory": "current_project_directory",
		"blinking": "terminal_controlled",
		"cursor_shape": null,
		"button": true,
		"line_height": "comfortable",
		"detect_venv": {
			"on": {
				"directories": [".env", "env", ".venv", "venv"],
				"activate_script": "default"
			}
		}
	},

	"lsp": {
		//"omnisharp": {
		//	"binary": {
		//		"path": "omnisharp",
		//		"arguments": ["optional", "additional", "args", "-lsp"]
		//	}
		//}
		//"csharp": {
		//	"command": "omnisharp",
		//	"args": ["-lsp"],
		//	"language_id": "csharp",
		//	"root_markers": ["*.csproj", "*.sln"]
		//}
		//"omnisharp": {
		//	"binary": {
		//		"path": "csharp-language-server"
		//	}
		//}
	},

	// Vim settings
	"vim": {
		"toggle_relative_line_numbers": true,
		"use_system_clipboard": "never",
		"use_smartcase_find": true,
		"custom_digraphs": {}
	},

	"line_indicator_format": "short"
}
