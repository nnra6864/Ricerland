[
	{
		"context": "Workspace",
		"bindings": {
			"shift": "file_finder::Toggle",
			"space s f": "file_finder::Toggle",
			"alt-h": "pane::GoBack",
			"alt-l": "pane::GoForward"
		}
	},
	{
		"context": "Editor",
		"bindings": {
			"ctrl-shift-c": "editor::Copy",
			"ctrl-shift-v": "editor::Paste",
			"alt-w": "pane::CloseActiveItem",
			"ctrl-alt-h": ["workspace::ActivatePaneInDirection", "Left"],
			"ctrl-alt-l": ["workspace::ActivatePaneInDirection", "Right"]
		}
	}
]
