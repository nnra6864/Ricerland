#custom-shader = shaders/ghostty-shader-playground/public/shaders/cursor_frozen.glsl
custom-shader = shaders/ghostty-shader-playground/public/shaders/cursor_smear.glsl
#custom-shader = shaders/ghostty-shader-playground/public/shaders/cursor_smear_fade.glsl
#custom-shader = shaders/ghostty-shader-playground/public/shaders/cursor_smear_gradient.glsl
#custom-shader = shaders/ghostty-shader-playground/public/shaders/cursor_smear_rainbow.glsl
