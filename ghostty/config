config-file = Ricer
gtk-single-instance = true
quit-after-last-window-closed = false

font-synthetic-style = true
font-size = 13

cursor-style = block
focus-follows-mouse = true

window-padding-x = 10
window-padding-y = 10

resize-overlay = never
image-storage-limit = 4294967295
confirm-close-surface = false

custom-shader-animation = always
#custom-shader = shaders/ghostty-shader-playground/public/shaders/blaze_sparks.glsl
#custom-shader = shaders/ghostty-shader-playground/public/shaders/cursor_blaze.glsl
